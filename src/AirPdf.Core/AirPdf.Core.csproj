<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AirPdf.Core</RootNamespace>
    <AssemblyName>AirPdf.Core</AssemblyName>
    <Description>PDF document services for AirPDF.</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Kept for its native payload, not its managed API. PDFtoImage brings in
      bblanchon.PDFium.{Win32,Linux,macOS} (pdfium.dll / libpdfium.so / libpdfium.dylib for
      every target we publish) plus the SkiaSharp native assets. Rendering itself goes
      through src/AirPdf.Core/Pdfium, because PDFtoImage's document type is internal and its
      public API reparses the file on every call, which cost a full document load per page.

      Removing this package means adding those native references directly; do that only
      with a Linux and macOS publish verified end to end.
    -->
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
