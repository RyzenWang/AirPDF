<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AirPdf.App.App">
  <!-- No fixed RequestedThemeVariant: the view model sets it (Default follows the OS,
       including its high-contrast variant). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://AirPdf/Styles/Colors.axaml" />
        <ResourceInclude Source="avares://AirPdf/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AirPdf/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
