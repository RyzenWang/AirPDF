<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AirPdf.App</RootNamespace>
    <AssemblyName>AirPdf</AssemblyName>
    <ApplicationIcon>Assets/airpdf.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.6.0-preview.1</Version>
    <AssemblyTitle>AirPDF</AssemblyTitle>
    <Product>AirPDF</Product>
    <Description>A feather-light, cross-platform PDF reader built with .NET and Avalonia.</Description>
    <Authors>AirPDF contributors</Authors>
    <Copyright>Copyright (c) AirPDF contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />

    <!--
      Two SkiaSharp native packages can end up in the graph on Linux, and they are different
      package ids, so NuGet does not unify them:

        SkiaSharp.NativeAssets.Linux                (Avalonia.Skia asks for 2.88.9)
        SkiaSharp.NativeAssets.Linux.NoDependencies (PDFtoImage asks for 4.150.1)

      Both ship runtimes/linux-x64/native/libSkiaSharp.so, which caused two separate failures:

      1. The 2.88.9 copy won the file conflict, so the 4.150.1 managed SkiaSharp loaded
         native 88.1 and refused to start.
      2. The .NoDependencies build is compiled without fontconfig, so it cannot see any
         system font; Avalonia then threw "Default font family name can't be null or empty".

      Taking the 4.150.1 fontconfig build and dropping the .NoDependencies copy leaves one
      native library of the right version that can see the system fonts (including CJK).
      Windows and macOS never had this problem: there the package ids match, so NuGet
      unified them to 4.150.1.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" ExcludeAssets="native" />
  </ItemGroup>

  <!--
    Keep PdfPig whole when trimming: it is not annotated for trimming, so the analyzer cannot
    tell whether its internals reflect over their own types, and rooting it costs little.
    Velopack is deliberately NOT rooted. Rooting it made the AOT compiler compile its COM
    shortcut class, which reports "will always throw" because its IL cannot be compiled;
    without the root that code is unreachable and trimmed away, the warning disappears, and
    the AOT binary is 1.1 MB smaller. Ignored when trimming is off.
  -->
  <ItemGroup>
    <TrimmerRootAssembly Include="UglyToad.PdfPig" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AirPdf.Core\AirPdf.Core.csproj" />
  </ItemGroup>

  <Target Name="RemovePdbsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishPdbs Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishPdbs)" />
  </Target>
</Project>
