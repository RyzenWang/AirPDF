<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:AirPdf.App.Controls">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="34" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.3" />
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
  </Style>
  <Style Selector="TextBlock.pageNumber">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>

  <Style Selector="Path.icon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.icon.small">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <Style Selector="Path.icon.muted">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Path.icon.accent">
    <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.38" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>

  <!-- The pen and its palette arrow read as one control: the group carries the hover and
       active background, and its buttons stay transparent so no seam appears between them. -->
  <Style Selector="Border.toolGroup">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.toolGroup.hover">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Border.toolGroup.active">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Button.toolMain">
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8,0,0,8" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toolCaret">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="34" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="0,8,8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.toolMain:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.toolMain:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.toolCaret:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.toolCaret:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.icon.inkOn /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Button.zoom">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Padding" Value="17,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
  </Style>
  <Style Selector="Button.soft">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.soft:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="Button.home">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.home /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.home:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="Button.home:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Button.tab.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- The document tab strip. The selected pill is drawn by the Border in the item
       template; the ListBoxItem itself stays transparent so Fluent's blue selection
       chrome never leaks through. -->
  <Style Selector="ListBox.tabStrip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- The default Fluent horizontal bar grows on hover/drag; the tab strip only needs a
       hairline. Capping the ScrollBar itself keeps every visual state at this height. -->
  <Style Selector="ListBox.tabStrip ScrollBar:horizontal">
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Margin" Value="0,0,0,1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabStrip Border.tabPill">
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:pointerover Border.tabPill">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:pressed Border.tabPill">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:selected Border.tabPill">
    <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:selected:pointerover Border.tabPill">
    <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:selected:pressed Border.tabPill">
    <Setter Property="Background" Value="{DynamicResource TabActiveBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TabActiveBorderBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip TextBlock.tabTitle">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:pointerover TextBlock.tabTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:selected TextBlock.tabTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Path.tabDocIcon">
    <Setter Property="Width" Value="13" />
    <Setter Property="Height" Value="13" />
    <Setter Property="Stroke" Value="{DynamicResource TextTertiaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.7" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:pointerover Path.tabDocIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:selected Path.tabDocIcon">
    <Setter Property="Stroke" Value="{DynamicResource TabActiveIconBrush}" />
  </Style>
  <Style Selector="Button.tabClose">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Path.tabCloseIcon">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="Stroke" Value="{DynamicResource TabCloseBrush}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:pointerover Button.tabClose Path.tabCloseIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.tabStrip ListBoxItem:selected Button.tabClose Path.tabCloseIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.tabClose:pointerover Path.tabCloseIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.tabClose:pressed Path.tabCloseIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.tabNew">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Path.tabNewIcon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Button.tabNew:pointerover Path.tabNewIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.tabNew:pressed Path.tabNewIcon">
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <!-- At the minimum window width the toolbar tightens its rhythm. The two fit
       shortcuts fold into the existing zoom menu so the right-hand controls stay
       inside the window. -->
  <Style Selector="Border.toolbar.compact">
    <Setter Property="Padding" Value="6,9" />
  </Style>
  <Style Selector="Border.toolbar.compact StackPanel.toolbarCenter">
    <Setter Property="Spacing" Value="2" />
  </Style>
  <Style Selector="Border.toolbar.compact StackPanel.toolbarRight">
    <Setter Property="Spacing" Value="0" />
  </Style>
  <Style Selector="Button.soft.tabOpen">
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="9,0,10,0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <!-- Managed Windows caption buttons. They follow the native 46x32 metrics inside the
       44px workspace bar; the close button keeps the OS red for its hover state. -->
  <Style Selector="Button.windowControl">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.windowGlyph">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Stroke" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="StrokeThickness" Value="1.1" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Button.windowControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="Button.windowControl:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
  </Style>
  <Style Selector="Button.windowClose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#C42B1C" />
  </Style>
  <Style Selector="Button.windowClose:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B0271A" />
  </Style>
  <Style Selector="Button.windowClose:pointerover Path.windowGlyph">
    <Setter Property="Stroke" Value="White" />
  </Style>
  <Style Selector="Button.windowClose:pressed Path.windowGlyph">
    <Setter Property="Stroke" Value="White" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="15" />
  </Style>
  <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>

  <Style Selector="Button.recent">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>
  <Style Selector="TextBox.pageBox">
    <Setter Property="Width" Value="42" />
    <Setter Property="Padding" Value="0,5" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="TextBox.searchBox">
    <Setter Property="Padding" Value="33,7,30,7" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
    <Setter Property="Height" Value="3" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="controls|PdfPageList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="SelectionMode" Value="Single" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <ScrollViewer Name="PART_ScrollViewer"
                      Background="Transparent"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Padding="24,24,24,64">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />
        </ScrollViewer>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|PdfPageList ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,28" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.thumbnailList">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,4,6,24" />
  </Style>
  <Style Selector="ListBox.thumbnailList ListBoxItem">
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ItemRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                HorizontalAlignment="Center">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.thumbnailList ListBoxItem:pointerover /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.thumbnailList ListBoxItem:selected /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="ListBox.searchResults">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.searchResults ListBoxItem">
    <Setter Property="Padding" Value="11,9" />
    <Setter Property="Margin" Value="0,0,0,5" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ItemRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.searchResults ListBoxItem:pointerover /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector="ListBox.searchResults ListBoxItem:selected /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <Style Selector="TreeView.outlineTree">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="TreeView.outlineTree TreeViewItem">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="2,0" />
  </Style>
</Styles>
