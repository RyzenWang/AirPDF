<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AirPdf.App.ViewModels"
        xmlns:views="using:AirPdf.App.Views"
        xmlns:controls="using:AirPdf.App.Controls"
        x:Class="AirPdf.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://AirPdf/Assets/airpdf.ico"
        Width="1240"
        Height="860"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Tab strip. Its DataContext is the WindowViewModel (the tab host), set in code,
         which is why compiled bindings are opted out: the window's DataContext is the
         active document's view model. Hidden while only one tab exists. -->
    <Border x:Name="TabStrip"
            Grid.Row="0"
            IsVisible="False"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <ListBox x:Name="TabList"
                 x:CompileBindings="False"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ItemsSource="{Binding Tabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                 SelectionChanged="OnTabSelectionChanged">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,2">
                <TextBlock Text="{Binding TabTitle}"
                           MaxWidth="200"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <Button Classes="icon"
                        Width="18"
                        Height="18"
                        MinHeight="18"
                        Padding="0"
                        Click="OnCloseTabClick"
                        ToolTip.Tip="{DynamicResource L.CloseTab}"
                        AutomationProperties.Name="{DynamicResource L.CloseTab}">
                  <Path Data="{StaticResource IconClose}"
                        Stroke="{DynamicResource TextTertiaryBrush}"
                        StrokeThickness="1.8"
                        StrokeLineCap="Round"
                        Stretch="Uniform"
                        Width="8"
                        Height="8" />
                </Button>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Classes="icon"
                Width="24"
                Height="24"
                MinHeight="24"
                Padding="0"
                Click="OnNewTabClick"
                ToolTip.Tip="{DynamicResource L.NewTabHint}"
                AutomationProperties.Name="{DynamicResource L.NewTabHint}">
          <Path Classes="icon small" Data="{StaticResource IconPlus}" />
        </Button>
      </StackPanel>
    </Border>

    <!-- Top bar -->
    <Border Grid.Row="1"
            Background="{DynamicResource ToolbarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,9">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="31" Height="31" CornerRadius="8" Background="{DynamicResource AccentBrush}">
            <Path Data="{StaticResource IconPlane}"
                  Fill="White"
                  Stretch="Uniform"
                  Width="18"
                  Height="18"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="AirPDF"
                     FontSize="15.5"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     LetterSpacing="-0.2" />
          <Border Width="1" Height="19" Background="{DynamicResource BorderBrush}" Margin="4,0" VerticalAlignment="Center" />
          <Button Classes="soft"
                  Command="{Binding OpenCommand}"
                  AutomationProperties.Name="{DynamicResource L.OpenPdf}"
                  ToolTip.Tip="{DynamicResource L.OpenTooltip}">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Path Classes="icon small"
                    Data="{StaticResource IconFolderOpen}"
                    Stroke="{DynamicResource AccentTextBrush}" />
              <TextBlock Text="{DynamicResource L.Open}" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsDocumentOpen}">
          <Button Classes="icon"
                  Command="{Binding NavigateBackCommand}"
                  IsVisible="{Binding CanNavigateBack}"
                  AutomationProperties.Name="{DynamicResource L.NavigateBack}"
                  ToolTip.Tip="{DynamicResource L.NavigateBack}">
            <Path Classes="icon" Data="{StaticResource IconHistory}" />
          </Button>
          <Button Classes="icon"
                  Command="{Binding PreviousPageCommand}"
                  IsEnabled="{Binding CanGoPrevious}"
                  AutomationProperties.Name="{DynamicResource L.PreviousPage}"
                  ToolTip.Tip="{DynamicResource L.PreviousPage}">
            <Path Classes="icon" Data="{StaticResource IconChevronLeft}" />
          </Button>
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="2,0"
                  Margin="2,0">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <TextBox x:Name="PageNumberBox"
                       Classes="pageBox"
                       Text="{Binding PageNumberInput, Mode=TwoWay}"
                       AutomationProperties.Name="{DynamicResource L.PageNumberLabel}"
                       KeyDown="OnPageNumberKeyDown"
                       LostFocus="OnPageNumberLostFocus" />
              <TextBlock Text="/"
                         Foreground="{DynamicResource TextTertiaryBrush}"
                         VerticalAlignment="Center"
                         FontSize="11" />
              <TextBlock Text="{Binding PageCount}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         VerticalAlignment="Center"
                         FontSize="11.5"
                         FontWeight="SemiBold"
                         MinWidth="22"
                         Margin="4,0,5,0" />
            </StackPanel>
          </Border>
          <Button Classes="icon"
                  Command="{Binding NextPageCommand}"
                  IsEnabled="{Binding CanGoNext}"
                  AutomationProperties.Name="{DynamicResource L.NextPage}"
                  ToolTip.Tip="{DynamicResource L.NextPage}">
            <Path Classes="icon" Data="{StaticResource IconChevronRight}" />
          </Button>

          <Border Width="1" Height="19" Background="{DynamicResource BorderBrush}" Margin="8,0" VerticalAlignment="Center" />

          <Button Classes="zoom"
                  Command="{Binding ZoomOutCommand}"
                  AutomationProperties.Name="{DynamicResource L.ZoomOut}"
                  ToolTip.Tip="{DynamicResource L.ZoomOut}">
            <Border Width="12" Height="1.5" CornerRadius="1" Background="{DynamicResource TextPrimaryBrush}" />
          </Button>
          <Button Classes="chip"
                  Content="{Binding ZoomText}"
                  Padding="9,5"
                  MinWidth="58"
                  AutomationProperties.Name="{DynamicResource L.ZoomLevelLabel}"
                  ToolTip.Tip="{DynamicResource L.ZoomPreset}">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="{DynamicResource L.FitWidth}" Tag="fit-width" Click="OnFitWidthMenuClick" />
                <MenuItem Header="{DynamicResource L.FitPage}" Tag="fit-page" Click="OnFitPageMenuClick" />
                <MenuItem Header="{DynamicResource L.ActualSize}" Tag="actual" Click="OnActualSizeMenuClick" />
                <MenuItem Header="50%" Tag="0.5" Click="OnZoomPresetMenuClick" />
                <MenuItem Header="75%" Tag="0.75" Click="OnZoomPresetMenuClick" />
                <MenuItem Header="125%" Tag="1.25" Click="OnZoomPresetMenuClick" />
                <MenuItem Header="150%" Tag="1.5" Click="OnZoomPresetMenuClick" />
                <MenuItem Header="200%" Tag="2" Click="OnZoomPresetMenuClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="zoom"
                  Command="{Binding ZoomInCommand}"
                  AutomationProperties.Name="{DynamicResource L.ZoomIn}"
                  ToolTip.Tip="{DynamicResource L.ZoomIn}">
            <Path Classes="icon small" Data="{StaticResource IconPlus}" />
          </Button>
          <Button Classes="icon"
                  Command="{Binding FitWidthCommand}"
                  AutomationProperties.Name="{DynamicResource L.FitWidth}"
                  ToolTip.Tip="{DynamicResource L.FitWidth}">
            <Path Classes="icon" Data="{StaticResource IconFitWidth}" />
          </Button>
          <Button Classes="icon"
                  Command="{Binding FitPageCommand}"
                  AutomationProperties.Name="{DynamicResource L.FitPage}"
                  ToolTip.Tip="{DynamicResource L.FitPage}">
            <Path Classes="icon" Data="{StaticResource IconFitPage}" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
          <Button Classes="icon"
                  Command="{Binding ToggleSearchCommand}"
                  IsVisible="{Binding IsDocumentOpen}"
                  AutomationProperties.Name="{DynamicResource L.FindInDocument}"
                  ToolTip.Tip="{DynamicResource L.FindInDocument}">
            <Path Classes="icon" Data="{StaticResource IconSearch}" />
          </Button>
          <Button Classes="icon"
                  Command="{Binding ToggleSidebarCommand}"
                  IsVisible="{Binding IsDocumentOpen}"
                  AutomationProperties.Name="{DynamicResource L.ToggleThumbnails}"
                  ToolTip.Tip="{DynamicResource L.ToggleThumbnails}">
            <Path Classes="icon" Data="{StaticResource IconSidebar}" />
          </Button>
          <Button Classes="chip"
                  Width="43"
                  MinHeight="30"
                  Padding="0,5"
                  Content="{Binding LanguageShortLabel}"
                  FontWeight="SemiBold"
                  AutomationProperties.Name="{DynamicResource L.Language}"
                  ToolTip.Tip="{DynamicResource L.Language}">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="English" Tag="en" Click="OnLanguageMenuItemClick" />
                <MenuItem Header="简体中文" Tag="zh-CN" Click="OnLanguageMenuItemClick" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="icon"
                  Command="{Binding ToggleThemeCommand}"
                  AutomationProperties.Name="{Binding ThemeTooltip}"
                  ToolTip.Tip="{Binding ThemeTooltip}">
            <Panel>
              <Path Classes="icon" Data="{StaticResource IconMoon}" IsVisible="{Binding IsLightTheme}" />
              <Path Classes="icon" Data="{StaticResource IconSun}" IsVisible="{Binding IsDarkTheme}" />
            </Panel>
          </Button>
          <Button x:Name="InfoButton"
                  Classes="icon"
                  IsVisible="{Binding IsDocumentOpen}"
                  AutomationProperties.Name="{DynamicResource L.DocumentDetails}"
                  ToolTip.Tip="{DynamicResource L.DocumentDetails}">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" Opened="OnInfoFlyoutOpened">
                <Border Width="326" Padding="14">
                  <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                      <TextBlock Text="{DynamicResource L.DocumentDetails}" Classes="h3" />
                      <TextBlock Text="{Binding FileName}" Classes="caption" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Metadata}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MetadataRow">
                          <Grid ColumnDefinitions="92,*" Margin="0,0,0,7">
                            <TextBlock Text="{Binding Label}" Classes="caption" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{DynamicResource L.CheckForUpdates}"
                            Command="{Binding CheckForUpdatesCommand}"
                            Classes="chip"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
            <Path Classes="icon" Data="{StaticResource IconInfo}" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
      <!-- Thumbnail / outline rail -->
      <Border Grid.Column="0"
              Width="252"
              IsVisible="{Binding IsSidebarShown}"
              Background="{DynamicResource SidebarBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">
          <Grid Margin="15,13,12,8" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource L.Navigate}" Classes="eyebrow" />
              <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Classes="tab"
                        Classes.active="{Binding IsPagesTabSelected}"
                        Content="{DynamicResource L.Pages}"
                        Command="{Binding ShowPagesTabCommand}" />
                <Button Classes="tab"
                        Classes.active="{Binding IsContentsTabSelected}"
                        Content="{DynamicResource L.Contents}"
                        Command="{Binding ShowContentsTabCommand}" />
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="icon"
                    Command="{Binding ToggleSidebarCommand}"
                    AutomationProperties.Name="{DynamicResource L.HideSidebar}"
                    ToolTip.Tip="{DynamicResource L.HideSidebar}"
                    VerticalAlignment="Top">
              <Path Classes="icon small" Data="{StaticResource IconChevronLeft}" />
            </Button>
          </Grid>

          <Grid Grid.Row="1">
            <ListBox x:Name="ThumbnailList"
                     Classes="thumbnailList"
                     ItemsSource="{Binding Thumbnails}"
                     IsVisible="{Binding IsPagesTabSelected}"
                     AutomationProperties.Name="{DynamicResource L.ThumbnailsList}"
                     SelectionChanged="OnThumbnailSelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThumbnailViewModel">
                  <views:ThumbnailView />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Grid IsVisible="{Binding IsContentsTabSelected}">
              <TreeView x:Name="OutlineTree"
                        Classes="outlineTree"
                        ItemsSource="{Binding Bookmarks}"
                        Margin="8,2,8,16"
                        AutomationProperties.Name="{DynamicResource L.OutlineList}"
                        SelectionChanged="OnOutlineSelectionChanged">
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:BookmarkViewModel" ItemsSource="{Binding Children}">
                    <Grid ColumnDefinitions="*,Auto" Height="29" Margin="0,1">
                      <TextBlock Text="{Binding Title}"
                                 FontSize="12.5"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PageLabel}"
                                 Classes="pageNumber"
                                 VerticalAlignment="Center"
                                 Margin="8,0,3,0" />
                    </Grid>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
              <StackPanel IsVisible="{Binding HasNoBookmarks}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="9"
                          Margin="26">
                <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource SurfaceBrush}">
                  <Path Classes="icon muted" Data="{StaticResource IconBook}" />
                </Border>
                <TextBlock Text="{DynamicResource L.NoOutline}"
                           Classes="caption"
                           HorizontalAlignment="Center"
                           TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <!-- Reader canvas -->
      <Grid Grid.Column="1" ClipToBounds="True">
        <controls:PdfPageList x:Name="PagesList"
                              ItemsSource="{Binding Pages}"
                              IsVisible="{Binding IsDocumentOpen}"
                              AutomationProperties.Name="{DynamicResource L.Pages}"
                              ViewerScrollChanged="OnPagesScrollChanged">
          <!-- x:CompileBindings is opted out for the context menu: it is hosted in a
               popup and does not take part in the window's compiled-binding scope. -->
          <controls:PdfPageList.ContextMenu>
            <ContextMenu x:CompileBindings="False">
              <MenuItem Header="{DynamicResource L.CopySelection}"
                        Command="{Binding CopySelectionCommand}"
                        IsEnabled="{Binding HasSelection}" />
              <MenuItem Header="{DynamicResource L.SelectAll}"
                        Command="{Binding SelectAllTextCommand}" />
              <Separator />
              <MenuItem Header="{DynamicResource L.OpenContainingFolder}"
                        Command="{Binding OpenContainingFolderCommand}"
                        IsEnabled="{Binding IsDocumentOpen}" />
              <MenuItem Header="{DynamicResource L.OpenInNewWindow}"
                        Command="{Binding OpenInNewWindowCommand}"
                        IsEnabled="{Binding IsDocumentOpen}" />
              <MenuItem Header="{DynamicResource L.OpenInNewTab}"
                        Click="OnOpenInNewTabClick"
                        IsEnabled="{Binding IsDocumentOpen}" />
            </ContextMenu>
          </controls:PdfPageList.ContextMenu>
          <controls:PdfPageList.ItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
              <views:PdfPageView Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" />
            </DataTemplate>
          </controls:PdfPageList.ItemTemplate>
        </controls:PdfPageList>

        <!-- Welcome -->
        <ScrollViewer IsVisible="{Binding IsWelcomeVisible}"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <Grid MaxWidth="1020"
                MinHeight="560"
                Margin="46,34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ColumnDefinitions="1.15*,0.85*">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="0" Margin="0,0,36,0">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,17">
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource L.Tagline}" Classes="eyebrow" />
              </StackPanel>

              <TextBlock Text="{DynamicResource L.WelcomeTitle1}" Classes="h1" />
              <TextBlock Text="{DynamicResource L.WelcomeTitle2}" Classes="h1" />

              <TextBlock Text="{DynamicResource L.WelcomeSubtitle}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         FontSize="14"
                         LineHeight="22"
                         TextWrapping="Wrap"
                         MaxWidth="490"
                         Margin="0,16,0,26" />

              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="primary" Command="{Binding OpenCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="{StaticResource IconFolderOpen}"
                          Stroke="White"
                          StrokeThickness="1.8"
                          StrokeLineCap="Round"
                          StrokeJoin="Round"
                          Stretch="Uniform"
                          Width="17"
                          Height="17"
                          VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource L.OpenPdf}" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="11,0"
                        VerticalAlignment="Stretch">
                  <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl" Classes="caption" FontWeight="SemiBold" />
                    <TextBlock Text="O" Classes="caption" FontWeight="SemiBold" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <TextBlock Text="{DynamicResource L.WelcomeMeta}"
                         Classes="caption"
                         Margin="1,18,0,0" />

              <StackPanel IsVisible="{Binding HasRecentFiles}" Margin="0,34,0,0" Spacing="9">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource L.Recent}" Classes="eyebrow" VerticalAlignment="Center" />
                  <Button Grid.Column="1"
                          Content="{DynamicResource L.Clear}"
                          Classes="caption"
                          Command="{Binding ClearRecentCommand}"
                          Padding="7,2"
                          MinHeight="24"
                          Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>
                <ScrollViewer MaxHeight="300"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.Name="{DynamicResource L.RecentFilesList}">
                  <ItemsControl ItemsSource="{Binding RecentFiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RecentFileViewModel">
                      <Button Classes="recent" Command="{Binding OpenCommand}">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                          <Border Width="32" Height="32"
                                  CornerRadius="7"
                                  Background="{DynamicResource SurfaceAltBrush}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1"
                                  VerticalAlignment="Center">
                            <Path Classes="icon small muted" Data="{StaticResource IconFile}" />
                          </Border>
                          <StackPanel Grid.Column="1" Margin="10,0" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Directory}"
                                       Classes="caption"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2"
                                     Text="{Binding LastOpenedText}"
                                     Classes="caption tertiary"
                                     VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </StackPanel>

            <!-- Paper stack artwork -->
            <Viewbox Grid.Column="1"
                     Stretch="Uniform"
                     MaxWidth="370"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center">
              <Grid Width="370"
                    Height="414"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
              <Ellipse Width="265" Height="265"
                       Fill="{DynamicResource AccentSoftBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,22,8,0" />

              <Border Width="190" Height="254"
                      Background="#FCFAF6"
                      BorderBrush="#E1D9CD"
                      BorderThickness="1"
                      CornerRadius="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="14,46,0,0"
                      RenderTransformOrigin="0.5,0.5"
                      BoxShadow="0 14 34 0 #26000000">
                <Border.RenderTransform>
                  <RotateTransform Angle="-12" />
                </Border.RenderTransform>
                <StackPanel Margin="24,28" Spacing="8">
                  <Border Height="6" Width="48" CornerRadius="3" Background="#E3563B" />
                  <Border Height="4" Width="118" CornerRadius="2" Background="#D9D2C7" />
                  <Border Height="4" Width="96" CornerRadius="2" Background="#E6DFD4" />
                  <Border Height="4" Width="110" CornerRadius="2" Background="#E6DFD4" />
                </StackPanel>
              </Border>

              <Border Width="206" Height="274"
                      Background="#FBF8F2"
                      BorderBrush="#DED5C7"
                      BorderThickness="1"
                      CornerRadius="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="-6,22,0,0"
                      RenderTransformOrigin="0.5,0.5"
                      BoxShadow="0 16 38 0 #33000000">
                <Border.RenderTransform>
                  <RotateTransform Angle="7" />
                </Border.RenderTransform>
                <StackPanel Margin="26,32" Spacing="9">
                  <TextBlock Text="AIRPDF / 01" FontSize="8.5" FontWeight="Bold" LetterSpacing="1.4" Foreground="#A83A27" />
                  <Border Height="4" Width="122" CornerRadius="2" Background="#D7D0C5" Margin="0,5,0,0" />
                  <Border Height="4" Width="98" CornerRadius="2" Background="#E8E0D4" />
                  <Border Height="4" Width="116" CornerRadius="2" Background="#E8E0D4" />
                </StackPanel>
              </Border>

              <Border Width="220" Height="294"
                      Background="#FFFDF9"
                      BorderBrush="#D9D0C2"
                      BorderThickness="1"
                      CornerRadius="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"
                      RenderTransformOrigin="0.5,0.5"
                      BoxShadow="0 22 50 0 #40000000">
                <Border.RenderTransform>
                  <RotateTransform Angle="-2.5" />
                </Border.RenderTransform>
                <Grid Margin="26,28,26,24" RowDefinitions="Auto,Auto,*,Auto">
                  <TextBlock Text="AIRPDF  /  READER"
                             FontSize="8.5"
                             FontWeight="Bold"
                             LetterSpacing="1.4"
                             Foreground="#B0442F" />
                  <TextBlock Grid.Row="1"
                             Text="Read without the noise."
                             FontFamily="Georgia, Times New Roman, serif"
                             FontSize="24"
                             FontWeight="Bold"
                             LineHeight="27"
                             Foreground="#1D232C"
                             TextWrapping="Wrap"
                             Margin="0,16,0,0" />
                  <StackPanel Grid.Row="2" Spacing="8" Margin="0,24,0,0">
                    <Border Height="3.5" Width="148" CornerRadius="2" Background="#D8D0C4" />
                    <Border Height="3.5" Width="162" CornerRadius="2" Background="#E5DDD1" />
                    <Border Height="3.5" Width="126" CornerRadius="2" Background="#E5DDD1" />
                    <Border Height="3.5" Width="152" CornerRadius="2" Background="#E5DDD1" />
                  </StackPanel>
                  <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Width="18" Height="18" CornerRadius="5" Background="#E3563B">
                        <Path Data="{StaticResource IconPlane}"
                              Fill="White"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                      </Border>
                      <TextBlock Text="AirPDF" FontSize="9" FontWeight="Bold" Foreground="#3B352E" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="2026" FontSize="8" Foreground="#A69D90" VerticalAlignment="Center" />
                  </Grid>
                </Grid>
              </Border>
              </Grid>
            </Viewbox>
          </Grid>
        </ScrollViewer>

        <!-- Busy -->
        <Border IsVisible="{Binding IsBusy}"
                Background="{DynamicResource OverlayScrimBrush}">
          <Border Background="{DynamicResource SurfaceBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="26,22"
                  Width="280"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  BoxShadow="0 18 48 0 #33000000">
            <StackPanel Spacing="13">
              <ProgressBar IsIndeterminate="True" Width="228" />
              <TextBlock Text="{Binding BusyText}"
                         Classes="caption"
                         HorizontalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
        </Border>

        <!-- Error banner -->
        <Border IsVisible="{Binding HasError}"
                Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="13,9"
                MaxWidth="680"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,16,20,0"
                BoxShadow="0 10 28 0 #22000000">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
            <Path Classes="icon" Data="{StaticResource IconInfo}" Stroke="{DynamicResource DangerBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       FontSize="12.5" />
            <Button Grid.Column="2"
                    Classes="icon"
                    Width="26"
                    Height="26"
                    MinHeight="26"
                    Command="{Binding DismissErrorCommand}"
                    AutomationProperties.Name="{DynamicResource L.Dismiss}"
                    ToolTip.Tip="{DynamicResource L.Dismiss}">
              <Path Data="{StaticResource IconClose}"
                    Stroke="{DynamicResource DangerBrush}"
                    StrokeThickness="1.8"
                    StrokeLineCap="Round"
                    Stretch="Uniform"
                    Width="12"
                    Height="12" />
            </Button>
          </Grid>
        </Border>

        <!-- Drop target -->
        <Border IsVisible="{Binding IsDragOver}"
                Background="#E6FBF4EE"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="2"
                CornerRadius="16"
                Margin="22"
                IsHitTestVisible="False">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="13">
            <Border Width="62" Height="62" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
              <Path Classes="icon accent" Data="{StaticResource IconFolderOpen}" Width="28" Height="28" />
            </Border>
            <TextBlock Text="{DynamicResource L.DropToOpen}" Classes="h2" />
            <TextBlock Text="{DynamicResource L.DropHint}"
                       Classes="caption" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Search panel -->
      <Border Grid.Column="1"
              Width="342"
              IsVisible="{Binding IsSearchOpen}"
              HorizontalAlignment="Right"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1,0,0,0"
              BoxShadow="-14 0 36 0 #26000000">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
          <Grid Margin="16,14,12,8" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{DynamicResource L.SearchTitle}" Classes="h3" />
              <TextBlock Text="{DynamicResource L.SearchSubtitle}" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="1"
                    Classes="icon"
                    Command="{Binding CloseSearchCommand}"
                    AutomationProperties.Name="{DynamicResource L.CloseSearch}"
                    ToolTip.Tip="{DynamicResource L.CloseSearch}">
              <Path Classes="icon small" Data="{StaticResource IconClose}" />
            </Button>
          </Grid>

          <Grid Grid.Row="1" Margin="16,4,16,9" ColumnDefinitions="*,Auto" ColumnSpacing="7">
            <Grid>
              <TextBox x:Name="SearchBox"
                       Classes="searchBox"
                       Text="{Binding SearchQuery, Mode=TwoWay}"
                       Watermark="{DynamicResource L.SearchPlaceholder}"
                       AutomationProperties.Name="{DynamicResource L.SearchBoxLabel}"
                       KeyDown="OnSearchKeyDown" />
              <Path Classes="icon small muted"
                    Data="{StaticResource IconSearch}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Margin="11,0,0,0"
                    IsHitTestVisible="False" />
              <Button Classes="icon"
                      Width="27"
                      Height="27"
                      MinHeight="27"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Margin="0,0,3,0"
                      Command="{Binding ClearSearchCommand}"
                      IsVisible="{Binding HasSearchQuery}"
                      AutomationProperties.Name="{DynamicResource L.ClearSearch}"
                      ToolTip.Tip="{DynamicResource L.ClearSearch}">
                <Path Data="{StaticResource IconClose}"
                      Stroke="{DynamicResource TextTertiaryBrush}"
                      StrokeThickness="1.7"
                      StrokeLineCap="Round"
                      Stretch="Uniform"
                      Width="11"
                      Height="11" />
              </Button>
            </Grid>
            <Button Grid.Column="1" Classes="soft" Command="{Binding SearchCommand}" Content="{DynamicResource L.Find}" MinWidth="58" />
          </Grid>

          <Grid Grid.Row="2" Margin="16,2,14,8" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="{Binding SearchSummary}" Classes="caption" />
              <ProgressBar IsIndeterminate="True"
                           Width="54"
                           IsVisible="{Binding IsSearching}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
              <Button Classes="zoom"
                      Command="{Binding PreviousSearchResultCommand}"
                      IsEnabled="{Binding HasSearchResults}"
                      AutomationProperties.Name="{DynamicResource L.PreviousMatch}"
                      ToolTip.Tip="{DynamicResource L.PreviousMatch}">
                <Path Classes="icon small" Data="{StaticResource IconChevronLeft}" />
              </Button>
              <Button Classes="zoom"
                      Command="{Binding NextSearchResultCommand}"
                      IsEnabled="{Binding HasSearchResults}"
                      AutomationProperties.Name="{DynamicResource L.NextMatch}"
                      ToolTip.Tip="{DynamicResource L.NextMatch}">
                <Path Classes="icon small" Data="{StaticResource IconChevronRight}" />
              </Button>
            </StackPanel>
          </Grid>

          <Grid Grid.Row="3">
            <ListBox Classes="searchResults"
                     ItemsSource="{Binding SearchResults}"
                     SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                     Margin="10,0,8,0"
                     AutomationProperties.Name="{DynamicResource L.SearchResultsList}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultViewModel">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding PageLabel}"
                               FontSize="9.5"
                               FontWeight="Bold"
                               LetterSpacing="1.1"
                               Foreground="{DynamicResource AccentTextBrush}" />
                    <TextBlock Text="{Binding Snippet}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               MaxLines="3"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel IsVisible="{Binding HasNoSearchResults}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="9"
                        Margin="24">
              <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource SurfaceAltBrush}">
                <Path Classes="icon muted" Data="{StaticResource IconSearch}" />
              </Border>
              <TextBlock Text="{DynamicResource L.NoMatchesTitle}"
                         FontWeight="SemiBold"
                         HorizontalAlignment="Center" />
              <TextBlock Text="{DynamicResource L.NoMatchesHint}"
                         Classes="caption"
                         TextWrapping="Wrap"
                         TextAlignment="Center"
                         MaxWidth="220" />
            </StackPanel>
          </Grid>

          <Border Grid.Row="4"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="0,1,0,0"
                  Padding="16,9">
            <TextBlock Text="{DynamicResource L.SearchFooter}"
                       Classes="caption tertiary"
                       FontSize="10.5" />
          </Border>
        </Grid>
      </Border>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3"
            Height="30"
            Background="{DynamicResource StatusBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,0">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource TealBrush}" />
          <TextBlock Text="{Binding DocumentSubtitle}"
                     Classes="caption"
                     FontSize="11"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="soft"
                  Content="{Binding UpdateButtonText}"
                  Command="{Binding ApplyUpdateCommand}"
                  IsVisible="{Binding HasUpdate}"
                  IsEnabled="{Binding CanApplyUpdate}"
                  MinHeight="22"
                  Padding="8,2"
                  FontSize="10.5"
                  AutomationProperties.Name="{DynamicResource L.CheckForUpdates}"
                  ToolTip.Tip="{DynamicResource L.CheckForUpdates}" />
          <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" IsVisible="{Binding HasUpdate}" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasSelection}">
            <TextBlock Text="{Binding SelectionStatus}"
                       Classes="caption"
                       FontSize="11"
                       VerticalAlignment="Center" />
            <Button Classes="chip"
                    Content="{DynamicResource L.Copy}"
                    Command="{Binding CopySelectionCommand}"
                    MinHeight="22"
                    Padding="7,2"
                    FontSize="10.5"
                    AutomationProperties.Name="{DynamicResource L.CopySelection}"
                    ToolTip.Tip="{DynamicResource L.Copy}" />
          </StackPanel>
          <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" IsVisible="{Binding HasSelection}" />
          <TextBlock Text="{Binding PageStatusText}"
                     Classes="caption"
                     FontSize="11"
                     AutomationProperties.Name="{DynamicResource L.PageStatusFormat}"
                     IsVisible="{Binding IsDocumentOpen}" />
          <TextBlock Text="{Binding ReadingProgressText}"
                     Classes="caption tertiary"
                     FontSize="11"
                     VerticalAlignment="Center"
                     AutomationProperties.Name="{DynamicResource L.ReadingProgressLabel}"
                     IsVisible="{Binding IsDocumentOpen}" />
          <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" IsVisible="{Binding IsDocumentOpen}" />
          <TextBlock Text="PDFium"
                     Classes="caption tertiary"
                     FontSize="10.5" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
