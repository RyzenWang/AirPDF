<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AirPdf.App.Views.PasswordDialog"
        x:CompileBindings="False"
        Title="{DynamicResource L.PasswordTitle}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
  <Grid Margin="28,24,28,24" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
    <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
      <TextBlock Text="&#x2022;&#x2022;&#x2022;"
                 FontSize="18"
                 FontWeight="Bold"
                 Foreground="{DynamicResource AccentBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 Margin="0,-7,0,0" />
    </Border>

    <TextBlock Grid.Row="1" Margin="0,15,0,0" Classes="h2" Text="{DynamicResource L.PasswordHeading}" />
    <TextBlock x:Name="FileNameText"
               Grid.Row="2"
               Margin="0,5,0,0"
               Classes="caption"
               TextTrimming="CharacterEllipsis" />

    <StackPanel Grid.Row="3" Margin="0,16,0,0" Spacing="7">
      <TextBlock Text="{DynamicResource L.PasswordLabel}" Classes="caption" />
      <TextBox x:Name="PasswordBox"
               PasswordChar="&#x25CF;"
               MinHeight="38"
               FontSize="13"
               KeyDown="OnPasswordKeyDown" />
      <TextBlock x:Name="ErrorText"
                 IsVisible="False"
                 Foreground="{DynamicResource DangerBrush}"
                 FontSize="11.5" />
    </StackPanel>

    <StackPanel Grid.Row="4"
                Margin="0,22,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="8">
      <Button Content="{DynamicResource L.Cancel}" MinWidth="82" Click="OnCancelClick" />
      <Button Content="{DynamicResource L.Unlock}" Classes="primary" MinWidth="92" Click="OnUnlockClick" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
